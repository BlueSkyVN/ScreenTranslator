<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Screen Translator" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="C# WPF MVVM Architecture" Foreground="Gray" Margin="0,0,0,15"/>
            
            <Button Content="Select Translation Region" FontSize="14" Margin="0,0,0,10" Padding="5" 
                    Command="{Binding SelectRegionCommand}" Cursor="Hand"/>
                    
            <CheckBox Content="Start Real-Time Translation" FontSize="16" 
                      IsChecked="{Binding IsRunning, Mode=TwoWay}" />
            
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <TextBlock Text="Target Language:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="150" SelectedValuePath="Tag" SelectedValue="{Binding TargetLang, Mode=TwoWay}">
                    <ComboBoxItem Content="Vietnamese (vi)" Tag="vi"/>
                    <ComboBoxItem Content="English (en)" Tag="en"/>
                    <ComboBoxItem Content="Japanese (ja)" Tag="ja"/>
                    <ComboBoxItem Content="Korean (ko)" Tag="ko"/>
                    <ComboBoxItem Content="Chinese (zh-CN)" Tag="zh-CN"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <TextBlock Text="AI Model:" FontWeight="Bold" VerticalAlignment="Center" Width="100"/>
                <ComboBox Width="250" SelectedValuePath="Tag" SelectedValue="{Binding ApiModel, Mode=TwoWay}">
                    <ComboBoxItem Content="Groq Llama 3.1 8B (Fast)" Tag="groq|llama-3.1-8b-instant"/>
                    <ComboBoxItem Content="Groq Llama 3.3 70B (High Quality)" Tag="groq|llama-3.3-70b-versatile"/>
                    <ComboBoxItem Content="OpenAI GPT-4o-mini" Tag="openai|gpt-4o-mini"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="API Key:" FontWeight="Bold" VerticalAlignment="Center" Width="100"/>
                <TextBox Width="250" VerticalAlignment="Center" Padding="2" Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Text="Status:" Margin="0,15,0,0" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="16"/>

            <TextBlock Text="Recognized Text (OCR):" Margin="0,15,0,0" FontWeight="Bold"/>
            <TextBlock Text="{Binding LastOcrText}" TextWrapping="Wrap" Foreground="Gray"/>
            
            <TextBlock Text="Refactored to MVVM!" Margin="0,30,0,0" FontStyle="Italic" Foreground="DarkGray"/>
        </StackPanel>
    </Grid>
</Window>
